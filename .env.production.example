# ═══════════════════════════════════════════════════════════════
# Flowmind School ERP — Variables de Producción
# Copiar a .env y completar con valores reales
# NUNCA commitear el archivo .env con valores reales
# ═══════════════════════════════════════════════════════════════

# ── Base de Datos ────────────────────────────────────────────
POSTGRES_USER=flowmind
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO_AQUI
# Usada por Prisma dentro del contenedor API
DATABASE_URL=postgresql://flowmind:CAMBIAR_PASSWORD_SEGURO_AQUI@db:5432/flowmind_master

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR_REDIS_PASSWORD_AQUI

# ── JWT (mínimo 32 caracteres cada uno) ─────────────────────
JWT_SECRET=CAMBIAR_POR_STRING_ALEATORIO_MINIMO_32_CHARS_AQUI
JWT_REFRESH_SECRET=CAMBIAR_POR_OTRO_STRING_ALEATORIO_MINIMO_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
# Lista separada por comas de orígenes permitidos
CORS_ORIGIN=https://tu-dominio.cl,https://www.tu-dominio.cl

# ── Almacenamiento (S3 / MinIO) ──────────────────────────────
STORAGE_DRIVER=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CAMBIAR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CAMBIAR_SECRET_KEY
AWS_S3_BUCKET=flowmind-erp-produccion
# Dejar vacío para usar AWS S3 real; completar para MinIO o compatibles
S3_ENDPOINT=

# ── Notificaciones (opcional) ────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=notificaciones@tu-dominio.cl
# SMTP_PASS=CAMBIAR_SMTP_PASSWORD

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
