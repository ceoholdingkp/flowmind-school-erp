{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@flowmind/shared": ["../../packages/shared/src/index.ts"],
      "@flowmind/validators": ["../../packages/validators/src/index.ts"]
    }
  },
  "include": ["src/**/*", "../../packages/shared/src/**/*", "../../packages/validators/src/**/*"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "dist", "node_modules"]
}
