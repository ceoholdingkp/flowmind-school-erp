# ═══════════════════════════════════════════════════════════════
# Flowmind School ERP — Variables de Entorno
# Copiar como .env en apps/api/
# ═══════════════════════════════════════════════════════════════

# ─── Base de datos Master ─────────────────────────────────────
DATABASE_URL="postgresql://flowmind:flowmind_dev_2026@localhost:5432/flowmind_master?schema=public"

# ─── Base de datos Tenant por defecto (para desarrollo) ──────
TENANT_DATABASE_URL="postgresql://flowmind:flowmind_dev_2026@localhost:5432/tenant_colegio_san_andres?schema=public"

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET="flowmind-school-erp-secret-dev-2026-cambiame-en-produccion"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379

# ─── S3 / MinIO ──────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="flowmind"
S3_SECRET_KEY="flowmind_dev_2026"
S3_BUCKET="flowmind-school-files"
S3_REGION="us-east-1"

# ─── App ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# ─── Integraciones (configurar cuando estén listas) ──────────
# SII_API_URL=""
# SII_API_KEY=""
# WEBPAY_COMMERCE_CODE=""
# WEBPAY_API_KEY=""
# KHIPU_RECEIVER_ID=""
# KHIPU_SECRET=""
